# Envio por e-mail (opcional). Sem isso, o app ainda baixa os arquivos normalmente.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=0              # 1 para porta 465 (SSL direto)
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=senha-de-app-de-16-digitos
SMTP_FROM=voce@gmail.com

# Onde ficam banco de dados e imagens (padrão: ./data)
# TRAVELNESS_DATA=/var/lib/travelness
PORT=5000
